---
import { getCollection } from 'astro:content';
import ProjectRow from '../components/ProjectRow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout title={site.name} description={site.description} activePath="/">
  <div class="page-shell">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <h1 id="hero-title">Yun-Chen Liu <span class="name-note">(Alice)</span></h1>
        <p class="identity-line">Psychology × Human-AI Interaction × Social Innovation</p>
        <p class="hero-summary">I am a psychology-trained researcher exploring how emerging technologies can augment human capability without weakening human agency, judgment, and relationships.</p>
        <p class="body-copy">My work spans Human-AI Interaction, technology for well-being, education, mental health, and social innovation.</p>
        <div class="hero-actions" aria-label="Explore the site">
          <a class="action-link primary" href="#selected-projects">Selected Projects</a>
          <a class="action-link" href="/about/">About Me</a>
          <a class="action-link" href="/cv/">CV</a>
        </div>
        <p class="affiliation-line">Department of Psychology, National Taiwan University<br />Currently an exchange student at the Singapore University of Technology and Design</p>
      </div>
      <figure class="hero-figure">
        {site.hero === 'a' ? (
        <svg viewBox="0 0 320 260" role="img" aria-labelledby="hero-figure-title">
          <title id="hero-figure-title">A blue circle for a person and a gray rounded square for a machine, overlapping</title>
          <circle cx="124" cy="132" r="100" style="fill: var(--human)" />
          <rect x="140" y="40" width="160" height="184" rx="44" style="fill: var(--machine); mix-blend-mode: multiply" />
          <circle cx="182" cy="132" r="9" style="fill: var(--dot)" />
        </svg>
        ) : site.hero === 'b' ? (
          <svg viewBox="0 0 320 260" role="img" aria-labelledby="hero-figure-title">
            <title id="hero-figure-title">A person and a machine in dialogue, with space for independent judgment</title>
            <circle cx="86" cy="130" r="62" style="fill: var(--human)" />
            <rect x="194" y="68" width="102" height="124" rx="30" style="fill: var(--machine)" />
            <path d="M138 101 Q170 76 202 101 M138 159 Q170 184 202 159" fill="none" stroke-width="2" stroke-linecap="round" style="stroke: var(--ink-soft)" />
            <circle cx="109" cy="130" r="9" style="fill: var(--dot)" />
          </svg>
        ) : (
          <svg viewBox="0 0 320 260" role="img" aria-labelledby="hero-figure-title">
            <title id="hero-figure-title">A machine provides a supporting frame while human judgment remains at the center</title>
            <path d="M64 108 V191 Q64 218 91 218 H229 Q256 218 256 191 V108" fill="none" stroke-width="30" stroke-linecap="round" style="stroke: var(--machine)" />
            <circle cx="160" cy="104" r="65" style="fill: var(--human)" />
            <circle cx="160" cy="104" r="9" style="fill: var(--dot)" />
          </svg>
        )}
        <figcaption>People, machines, and the space between them</figcaption>
      </figure>
    </section>

    <section class="question-band" aria-labelledby="guiding-question">
      <h2 id="guiding-question">The question that guides my work</h2>
      <blockquote>How can AI augment human capability without weakening human agency, judgment, and relationships?</blockquote>
    </section>

    <section class="home-section" id="selected-projects" aria-labelledby="selected-projects-title">
      <div class="section-heading">
        <h2 id="selected-projects-title">Selected Projects</h2>
        <a href="/projects/">All projects</a>
      </div>
      <div class="project-list">
        {projects.map((project) => <ProjectRow project={project} />)}
      </div>
    </section>

    <section class="throughline" aria-labelledby="throughline-title">
      <h2 id="throughline-title">How my questions have changed</h2>
      <ol class="path">
        <li><strong>Psychology</strong><span>Understanding human needs, behavior, and well-being.</span></li>
        <li><strong>Social innovation</strong><span>Bringing those questions into real support systems, with practitioners.</span></li>
        <li><strong>Building AI interventions</strong><span>Learning that efficiency alone does not make technology useful or responsible.</span></li>
        <li><strong>Human-AI relationships</strong><span>Studying trust, agency, and judgment so AI augments people rather than replaces them.</span></li>
      </ol>
    </section>
  </div>
</SiteLayout>
