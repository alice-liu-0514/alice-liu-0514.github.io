---
import { getCollection } from 'astro:content';
import ProjectRow from '../../components/ProjectRow.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<SiteLayout title="Projects" description="Research and social-impact projects by Yun-Chen Liu (Alice), focused on human-centered AI, education, and well-being." activePath="/projects/">
  <div class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">Research in practice</p>
      <h1>Projects</h1>
      <p class="lead">Work that begins with people’s needs and asks what technology should contribute.</p>
    </header>
    <div class="project-list">
      {projects.map((project, index) => <ProjectRow project={project} index={index} />)}
    </div>
  </div>
</SiteLayout>
