---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const description = data.summary;
---

<SiteLayout title={data.title} description={description} activePath="/projects/">
  <article class="page-shell">
    <header class="project-detail-header">
      <p class="eyebrow">{data.status}</p>
      <h1>{data.title}{data.alias && <span class="name-note" lang="zh-Hant"> {data.alias}</span>}</h1>
      <p class="subtitle">{data.subtitle}</p>
      <dl class="project-facts">
        {data.role && <div><dt>Role</dt><dd>{data.role}</dd></div>}
        {data.organization && <div><dt>{data.orgLabel}</dt><dd>{data.organization}</dd></div>}
        {data.location && <div><dt>Location</dt><dd>{data.location}</dd></div>}
        {data.year && <div><dt>When</dt><dd>{data.year}</dd></div>}
      </dl>
    </header>

    {data.cover && (
      <figure class="project-cover">
        <img src={data.cover} alt={data.coverAlt ?? ''} loading="lazy" />
      </figure>
    )}

    {data.metrics.length > 0 && (
      <section class="impact-section" aria-labelledby="impact-title">
        <h2 id="impact-title">Impact</h2>
        <div class="impact-grid">
          {data.metrics.map((metric) => (
            <div class="impact-item">
              <span class="impact-value">{metric.value}</span>
              <span class="impact-label">{metric.label}</span>
              {metric.note && <span class="impact-note">{metric.note}</span>}
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="project-body">
      <div>
        <div class="prose"><Content /></div>
        {data.sdgs.length > 0 && (
          <section class="detail-section" aria-labelledby="sdg-title">
            <h2 id="sdg-title">SDG alignment</h2>
            <div class="sdg-list">
              {data.sdgs.map((sdg) => (
                <div class="sdg-item">
                  <span class="sdg-number" aria-hidden="true">{sdg.number}</span>
                  <div>
                    <strong>SDG {sdg.number}: {sdg.name}</strong>
                    <p>{sdg.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}
        {data.links.length > 0 && (
          <section class="detail-section" aria-labelledby="evidence-title">
            <h2 id="evidence-title">Evidence and links</h2>
            <ul class="evidence-list">
              {data.links.map((link) => (
                <li>
                  {link.href
                    ? <a href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
                    : <span>{link.label}</span>}
                  {link.note && <span class="evidence-pending">{link.note}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
      <aside class="project-aside" aria-label="Project information">
        {data.tags.length > 0 && (
          <section class="aside-section">
            <h2>Topics</h2>
            <ul class="tag-list">{data.tags.map((tag) => <li>{tag}</li>)}</ul>
          </section>
        )}
        {data.relatedPublications.length > 0 && (
          <section class="aside-section">
            <h2>Related publications</h2>
            <ul class="evidence-list">
              {data.relatedPublications.map((publication) => (
                <li>
                  {publication.href
                    ? <a href={publication.href} target="_blank" rel="noreferrer">{publication.title} <span aria-hidden="true">↗</span></a>
                    : <span>{publication.title}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
    <a class="back-link" href="/projects/">← All projects</a>
  </article>
</SiteLayout>
