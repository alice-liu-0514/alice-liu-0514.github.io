---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const description = data.summary;
---

<SiteLayout title={data.title} description={description} activePath="/projects/">
  <article class="page-shell">
    <header class="project-detail-header">
      <p class="eyebrow">{data.status}{data.year ? ` · ${data.year}` : ''}</p>
      <h1>{data.title}</h1>
      <p class="subtitle">{data.subtitle}</p>
      <div class="project-facts" aria-label="Project details">
        {data.role && <span><strong>Role</strong> {data.role}</span>}
        {data.organization && <span><strong>Program</strong> {data.organization}</span>}
        {data.location && <span><strong>Location</strong> {data.location}</span>}
      </div>
    </header>

    {data.cover && (
      <figure class="project-cover">
        <img src={data.cover} alt={data.coverAlt ?? ''} loading="lazy" />
      </figure>
    )}

    {data.metrics.length > 0 && (
      <section class="impact-section" aria-labelledby="impact-title">
        <h2 id="impact-title">Project outcomes</h2>
        <div class="impact-grid">
          {data.metrics.map((metric) => (
            <div class="impact-item">
              <span class="impact-value">{metric.value}</span>
              <span class="impact-label">{metric.label}</span>
              {metric.note && <span class="impact-note">{metric.note}</span>}
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="project-body">
      <div class="prose"><Content /></div>
      <aside class="project-aside" aria-label="Project information">
        {data.tags.length > 0 && (
          <section class="aside-section">
            <h2>Topics</h2>
            <p>{data.tags.join(' · ')}</p>
          </section>
        )}
        {data.relatedPublications.length > 0 && (
          <section class="aside-section">
            <h2>Related publications</h2>
            <ul class="evidence-list">
              {data.relatedPublications.map((publication) => (
                <li>
                  {publication.href
                    ? <a href={publication.href} target="_blank" rel="noreferrer">{publication.title} <span aria-hidden="true">↗</span></a>
                    : <span>{publication.title}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}
        {data.sdgs.length > 0 && (
          <section class="aside-section">
            <h2>SDG alignment</h2>
            {data.sdgs.map((sdg) => (
              <div class="sdg-item">
                <strong>SDG {sdg.number} · {sdg.name}</strong>
                <p>{sdg.description}</p>
              </div>
            ))}
          </section>
        )}
        {data.links.length > 0 && (
          <section class="aside-section">
            <h2>Evidence & links</h2>
            <ul class="evidence-list">
              {data.links.map((link) => (
                <li>
                  {link.href
                    ? <a href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
                    : <span>{link.label}{link.note ? ` — ${link.note}` : ''}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
    <a class="back-link" href="/projects/">← All projects</a>
  </article>
</SiteLayout>
