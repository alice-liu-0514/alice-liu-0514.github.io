---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data, id } = project;
const meta = [data.role ?? data.status, data.organization, data.year].filter(Boolean).join(', ');
---

<article class="project-row">
  <div class="project-row-heading">
    <p class="eyebrow project-status">{meta}</p>
    <h3><a href={`/projects/${id}/`}>{data.title}</a></h3>
    <p class="project-subtitle">{data.subtitle}</p>
  </div>
  <p class="project-summary">{data.summary}</p>
  {data.metrics.length > 0 && (
    <ul class="row-metrics" aria-label="Key outcomes">
      {data.metrics.map((metric) => <li><strong>{metric.value}</strong>{metric.label.toLowerCase()}</li>)}
    </ul>
  )}
  {data.tags.length > 0 && <p class="project-topics">{data.tags.slice(0, 4).join(', ')}</p>}
</article>
