---
import '../styles/global.css';
import { navigation, site } from '../data/site';

interface Props {
  title: string;
  description: string;
  activePath?: string;
}

const { title, description, activePath = Astro.url.pathname } = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const socialImage = Astro.site ? new URL('/og-default.png', Astro.site).toString() : undefined;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.toString(),
  sameAs: [site.linkedin],
  jobTitle: 'Psychology-trained researcher',
  affiliation: site.affiliations.map((name) => ({ '@type': 'Organization', name })),
  knowsAbout: [
    'Human-AI Interaction',
    'Human-Centered AI',
    'Technology for Well-being',
    'Social Innovation',
  ],
};
---

<!doctype html>
<html lang="en" data-palette={site.palette}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f4" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
          <svg class="wordmark-mark" width="26" height="20" viewBox="0 0 26 20" aria-hidden="true">
            <circle cx="10" cy="10" r="9" style="fill: var(--human)" />
            <rect x="9" y="1" width="16" height="18" rx="5" style="fill: var(--machine); mix-blend-mode: multiply" />
          </svg>
          Yun-Chen Liu <span>(Alice)</span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map((item) => (
            <a href={item.href} aria-current={activePath === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation">
            {navigation.map((item) => (
              <a href={item.href} aria-current={activePath === item.href ? 'page' : undefined}>{item.label}</a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>Yun-Chen Liu (Alice)</p>
        <p>Psychology × Human-AI Interaction × Social Innovation</p>
        <p>
          {site.email && <><a href={`mailto:${site.email}`}>Email</a> · </>}
          <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        </p>
      </div>
    </footer>
  </body>
</html>
